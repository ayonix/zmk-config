#define COMBO(NAME, BINDINGS, KEYPOS, MS) \
  combo_##NAME { \
    bindings = <BINDINGS>; \
    key-positions = <KEYPOS>; \
    timeout-ms = <MS>; \
  };

#define COMBO_TERM_FAST 14
#define COMBO_TERM_NORMAL 20
#define COMBO_TERM_SLOW 45

#define COMBO_TIMEOUT 50

combos {
  compatible = "zmk,combos";

  COMBO(bootloader, &bootloader, 19 22, COMBO_TERM_SLOW)
  COMBO(studio_unlock, &studio_unlock, 6 7, COMBO_TERM_SLOW)

  COMBO(lbkt, &kp DE_LBKT, 13 25, COMBO_TERM_NORMAL)
  COMBO(lpar, &kp DE_LPAR, 14 26, COMBO_TERM_NORMAL)
  COMBO(lbrc, &kp DE_LBRC, 15 27, COMBO_TERM_NORMAL)
  COMBO(labk, &kp DE_LESS_THAN, 16 28, COMBO_TERM_NORMAL)
  COMBO(rabk, &kp DE_GREATER_THAN, 17 29, COMBO_TERM_NORMAL)
  COMBO(rbrc, &kp DE_RBRC, 18 30, COMBO_TERM_NORMAL)
  COMBO(rpar, &kp DE_RPAR, 19 31, COMBO_TERM_NORMAL)
  COMBO(rbkt, &kp DE_RBKT, 20 32, COMBO_TERM_NORMAL)

  COMBO(del, &kp DEL, 43 44, COMBO_TERM_NORMAL)
};
